name: Build and Release DB

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  build-and-release:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Clean unwanted files
        run: |
          # מחיקת תיקיית הגיטהאב על כל תכולתה
          rm -rf .github
          
          # מחיקת כל קובץ בעל סיומת GS (גדולות או קטנות, כולל A.GS)
          find . -type f -iname "*.gs" -delete

      - name: Create the DB archive
        run: |
          # אריזת כל מה שנשאר במאגר לקובץ אחד
          zip -r DB.zip .

      - name: Set Release Tag
        run: echo "TAG_NAME=v$(date +'%Y.%m.%d-%H%M%S')" >> $GITHUB_ENV

      - name: Upload to Downloads
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ env.TAG_NAME }}
          name: "DB Update ${{ env.TAG_NAME }}"
          # העלאת הקובץ שנוצר ללשונית ההורדות (Releases)
          files: DB.zip
